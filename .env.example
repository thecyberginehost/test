# --- Primary node: 48club BSC geth (Ashburn VA, sub-ms to BSC) ---
BSC_RPC_URL=http://changeme:8545
# BSC_WS_URL=ws://changeme:8546

# --- Optional additional chains (uncomment + set to enable) ---
# ETH_RPC_URL=
# POLYGON_RPC_URL=
# ARBITRUM_RPC_URL=

# --- Block explorer (for `cast etherscan-source`, source verification) ---
# BSCSCAN_API_KEY=

# --- Optional SSH access for long-running jobs on the Threadripper ---
# Set this only after you've added this sandbox's pubkey to authorized_keys.
# SSH_HOST=user@threadripper.lan
